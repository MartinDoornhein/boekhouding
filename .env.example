# Kopieer naar .env (staat in .gitignore) en vul in, of genereer hem met Terraform:
#   cd infra/scaleway && terraform output -raw env_file > ../../.env

# Scaleway Object Storage (Litestream-replica + jaararchief)
BOEKHOUDING_S3_BUCKET=
BOEKHOUDING_S3_REGION=nl-ams
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Optioneel
# BOEKHOUDING_PORT=5050
# BOEKHOUDING_HOST=127.0.0.1
# BOEKHOUDING_WACHTWOORD=
# BOEKHOUDING_DATA=/pad/naar/data
